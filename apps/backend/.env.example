# ==========================================
# HYRD Platform Environment Configuration Template
# ==========================================

# Port configuration
PORT=3001

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai-interviewer?schema=public"

# Better Auth Secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:3001"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_LIVE_MODEL="models/gemini-2.5-flash-native-audio-latest"
GEMINI_LIVE_ENDPOINT="wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent"

# Local AI Interview Simulation Fallback (Set to "true" to run without Gemini Live credentials)
ENABLE_LOCAL_SIMULATION="false"

# OAuth Authentication Providers (Optional for local development)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub API Token (Optional: elevates rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=""
